<UserControl x:Class="DICOM_Router.Views.IncomingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DICOM_Router.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Data View of incoming DICOM files-->
        <DataGrid Name="IncomingDataGrid" CanUserAddRows="False" 
                        AutoGenerateColumns="False" HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="SteelBlue"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter Property="BorderBrush" Value="White"/>  
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="*" Binding="{Binding date}"/>
                <DataGridTextColumn Header="Patient ID" Width="150" Binding="{Binding patientID}"/>
                <DataGridTextColumn Header="Name" Width="150" Binding="{Binding name}"/>
                <DataGridTextColumn Header="Modality" Width="150" Binding="{Binding modality}"/>
                <DataGridTextColumn Header="Images" Width="*" Binding="{Binding images}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
