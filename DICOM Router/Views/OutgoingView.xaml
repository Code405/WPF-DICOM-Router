<UserControl x:Class="DICOM_Router.Views.OutgoingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DICOM_Router.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Data Grid View of incoming DICOM files-->
        <DataGrid Name="OutgoingDataGrid" CanUserAddRows="False" ItemsSource="{Binding OutgoingStudiesList}"
                AutoGenerateColumns="False" HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="SteelBlue"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter Property="BorderBrush" Value="White"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="100" Binding="{Binding DateSent}"/>
                <DataGridTextColumn Header="Patient ID" Width="150" Binding="{Binding PatientId}"/>
                <DataGridTextColumn Header="Name" Width="150" Binding="{Binding PatientName}"/>
                <DataGridTextColumn Header="Modality" Width="75" Binding="{Binding ModalityType}"/>
                <DataGridTextColumn Header="Images" Width="50" Binding="{Binding ImageCount}"/>
                <DataGridTextColumn Header="Rule" Width="100" Binding="{Binding RuleName}"/>
                <DataGridTextColumn Header="Device" Width="50" Binding="{Binding DeviceName}"/>
                <DataGridTextColumn Header="Status" Width="*" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
